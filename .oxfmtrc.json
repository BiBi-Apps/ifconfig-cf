{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "preserve",
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".wrangler/**",
    "package-lock.json",
    "pnpm-lock.yaml"
  ]
}
